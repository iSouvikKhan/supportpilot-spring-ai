# SupportPilot configuration. Spring Boot reads these as environment variables.
# Every value is optional; defaults are shown. Placeholders are marked "your-...".
# Copy this file to backend/.env (it is imported automatically), or set real environment
# variables in your shell or IDE. Environment variables take precedence over .env.

# --- PostgreSQL (with pgvector) ---
DB_URL=jdbc:postgresql://localhost:5432/supportpilot
DB_USERNAME=supportpilot
DB_PASSWORD=supportpilot

# --- Model providers ---
# Chat: ollama | openai | google-genai        Embeddings: ollama | openai
AI_CHAT_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=ollama

# Ollama (default, local, no key). The chat model must support tool calling.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI (only when a provider above is "openai")
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini chat (only when AI_CHAT_PROVIDER=google-genai)
GOOGLE_API_KEY=your-google-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Optional overrides for the OpenAI embedding client (e.g. Gemini's OpenAI-compatible endpoint)
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDINGS_PATH=/v1/embeddings

# Vector size. Must match the embedding model (nomic-embed-text = 768).
EMBEDDING_DIMENSIONS=768
# HNSW (default) supports up to 2000 dimensions; use NONE for larger vectors
PGVECTOR_INDEX_TYPE=HNSW

# --- Application ---
# Key for the approver console (X-Approver-Key). Leave empty in development:
# a random key is generated and printed in the log at startup.
APPROVER_API_KEY=
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.4
REFUND_WINDOW_DAYS=30
CORS_ORIGINS=http://localhost:4200
PORT=8080
# DEBUG logs every prompt and model response
AI_LOG_LEVEL=INFO
